<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký thành công</title>
    <style>
        * { box-sizing: border-box; font-family: Arial, sans-serif; }
        body { margin: 0; min-height: 100vh; padding: 16px; display: flex; align-items: center; justify-content: center; background: #f3f5f9; }
        .card { width: 100%; max-width: 460px; padding: 32px 24px; background: #fff; border-radius: 12px; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,.1); }
        h2 { color: #218838; }
        p { color: #444; line-height: 1.6; overflow-wrap: anywhere; }
        a { display: inline-block; margin-top: 16px; padding: 12px 20px; color: #fff; background: #2878d0; border-radius: 6px; text-decoration: none; }
    </style>
</head>
<body>
    <main class="card">
        <h2>Đăng ký thành công!</h2>
        <p>Tài khoản <strong><%= email %></strong> đã được tạo.</p>
        <a href="/register">Quay lại trang đăng ký</a>
    </main>
</body>
</html>
